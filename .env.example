# Variables de entorno para user_preferences_api

# Puerto del servidor (interno: 8081, externo: 8081)
SERVER_PORT=8081
PREFERENCES_API_PORT=8081

# RabbitMQ Configuration (usar el servicio compartido del sistema)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=user
RABBITMQ_PASSWORD=user

# URLs de Feign Clients
TURISTA_SERVICE_URL=http://admin_users_api:8082
SERVICIO_SERVICE_URL=http://providers_api:8080

# Java Options
JAVA_OPTS_XMS=256m
JAVA_OPTS_XMX=512m
